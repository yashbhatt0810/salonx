# Postgres (Railway sets this automatically when you link the Postgres service)
DATABASE_URL=postgres://user:pass@host:5432/salonx

# Clerk — create a NEW application at https://dashboard.clerk.com and paste its keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Comma-separated owner emails — these get full access
OWNER_EMAILS=owner@example.com

# Shown in the sidebar and on bills
SALON_NAME=SalonX
TZ=Asia/Kolkata
